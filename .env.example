# Names only — never commit real values. Set these in .env.local (local) or the Vercel project settings.

# PostgreSQL connection string (required in production, e.g. Neon / Vercel Postgres).
# Leave unset locally to use the embedded PGlite database in ./.data/pglite.
DATABASE_URL=

# Session signing secret, 32+ random characters (required in production).
SESSION_SECRET=

# Password for the fictional demo accounts created by `npm run db:seed` (required to seed production).
SEED_PASSWORD=

# AI provider (optional). Without a key the deterministic rule-based extractor and template report
# narrative are used. With a key, Claude proposes facts and drafts narrative; both are validated.
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_MODEL=
AI_EFFORT=
AI_TIMEOUT_MS=
AI_MAX_TOKENS=
AI_MAX_INPUT_CHARS=

# Market data provider (not yet selected — the exact "REI" product and usage rights must be confirmed).
MARKET_PROVIDER=
MARKET_PROVIDER_API_KEY=

# Demo-only escape hatch: run production without DATABASE_URL on an ephemeral PGlite in /tmp.
# Data is lost on every cold start. Use only for a clearly labelled prototype.
ALLOW_EPHEMERAL_DB=
AUTO_SEED=
